generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Achievement {
  id          String   @id            // "champion", "speedster", etc.
  title       String                  // "CHAMPION"
  description String                  // "Win 100 matches"
  image       String                  // URL de l'image (ou nom de fichier)
  borderColor String                  // "border-amber-400"
  textColor   String                  // "text-amber-400"
  createdAt   DateTime @default(now())

  users UserAchievement[]
}

model UserAchievement {
  userId        Int
  achievementId String
  unlockedAt    DateTime @default(now())
  progress      Int      @default(0)   // 0-100 (%)
  unlocked      Boolean  @default(false)

  user        Profile     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
}

model Profile {
  userId      Int       @id
  displayName String?
  bio         String    @default("")
  avatarUrl   String?
  statusText  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}