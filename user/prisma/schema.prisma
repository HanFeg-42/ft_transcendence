generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["user"]
}

model Profile {
  userId      Int       @id
  displayName String?
  bio         String    @default("")
  avatarUrl   String?
  statusText  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@schema("user")
}