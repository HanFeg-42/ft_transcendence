#postgres
POSTGRES_USER=pacova
POSTGRES_PASSWORD=pacova123
POSTGRES_DB=pacova

#one shared physical database — each service owns its own schema inside it
#(auth, user, chat, game), enforced via Prisma's `schemas` + `@@schema(...)`,
#not by having a separate database per service.
AUTH_DATABASE_URL=postgresql://pacova:pacova123@postgres:5432/pacova
GAME_DATABASE_URL=postgresql://pacova:pacova123@postgres:5432/pacova
CHAT_DATABASE_URL=postgresql://pacova:pacova123@postgres:5432/pacova
USER_DATABASE_URL=postgresql://pacova:pacova123@postgres:5432/pacova


JWT_SECRET=replace_with_a_secure_random_secret
REFRESH_TOKEN_SECRET=replace_with_a_different_secure_random_secret

TWO_FACTOR_CHALLENGE_SECRET=secure_number

#42 intra OAuth app (https://profile.intra.42.fr/oauth/applications)
FORTYTWO_CLIENT_ID=your_42_client_id
FORTYTWO_CLIENT_SECRET=your_42_client_secret
FORTYTWO_CALLBACK_URL=https://localhost:443/api/auth/42/callback
FRONTEND_URL=https://localhost:443
