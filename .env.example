#postgres
POSTGRES_USER=pacova
POSTGRES_PASSWORD=pacova123
# development default: change it for anything beyond local use
POSTGRES_DB=pacova

# One PostgreSQL server, one database per service (auth_db, user_db, chat_db, game_db).
# The databases are created by postgres-db/init.sql the first time the volume starts.
AUTH_DATABASE_URL=postgresql://pacova:pacova123@postgres:5432/auth_db
GAME_DATABASE_URL=postgresql://pacova:pacova123@postgres:5432/game_db
CHAT_DATABASE_URL=postgresql://pacova:pacova123@postgres:5432/chat_db
USER_DATABASE_URL=postgresql://pacova:pacova123@postgres:5432/user_db

# generate a secret with: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_secret
REFRESH_TOKEN_SECRET=replace_with_a_different_secure_random_secret
TWO_FACTOR_CHALLENGE_SECRET=replace_with_a_third_secure_random_secret
INTERNAL_API_KEY=replace_with_a_4rd_secure_random_secret

#42 intra OAuth app (https://profile.intra.42.fr/oauth/applications)
FORTYTWO_CLIENT_ID=your_42_client_id
FORTYTWO_CLIENT_SECRET=your_42_client_secret
FORTYTWO_CALLBACK_URL=https://localhost:443/api/auth/42/callback
FRONTEND_URL=https://localhost:443
