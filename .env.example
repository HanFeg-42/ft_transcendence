# 1. Copy this file:   cp .env.example .env
# 2. Replace every placeholder below with your own values.


# --- PostgreSQL (REQUIRED) ---------------------------------------------------
# Local development defaults. Change the password for anything beyond local use.
POSTGRES_USER=pacova
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=pacova


# --- Service databases (REQUIRED) --------------------------------------------
# One PostgreSQL server, one database per service (auth_db, user_db, chat_db, game_db).
# The databases are created by postgres-db/init.sql the first time the volume starts.
# The user/password here must match POSTGRES_USER / POSTGRES_PASSWORD above.
AUTH_DATABASE_URL=postgresql://pacova:change_me_db_password@postgres:5432/auth_db
USER_DATABASE_URL=postgresql://pacova:change_me_db_password@postgres:5432/user_db
CHAT_DATABASE_URL=postgresql://pacova:change_me_db_password@postgres:5432/chat_db
GAME_DATABASE_URL=postgresql://pacova:change_me_db_password@postgres:5432/game_db


# --- Secrets (REQUIRED) ------------------------------------------------------
# Generate each one with:   openssl rand -hex 32
# Use a DIFFERENT value for each variable.
JWT_SECRET=replace_with_random_secret_1
REFRESH_TOKEN_SECRET=replace_with_random_secret_2
TWO_FACTOR_CHALLENGE_SECRET=replace_with_random_secret_3
# Shared key for service-to-service calls (auth/user/game -> chat)
INTERNAL_API_KEY=replace_with_random_secret_4


# --- 42 intra OAuth (OPTIONAL) -----------------------------------------------
# Create an app at https://profile.intra.42.fr/oauth/applications
# The callback URL must match the redirect URI registered in your 42 app EXACTLY.
FORTYTWO_CLIENT_ID=your_42_client_id
FORTYTWO_CLIENT_SECRET=your_42_client_secret
FORTYTWO_CALLBACK_URL=https://localhost/api/auth/42/callback


# --- Frontend URL (REQUIRED) -------------------------------------------------
# Where the browser reaches the app (nginx on port 443). Used for OAuth redirects.
FRONTEND_URL=https://localhost